@vqeaf 1.0

<theme id="symbian_s3_s60_green" name="S60 Green">
    metadata {
        author: "Symbian S3 OS"
        version: "1.1.0"
        description: "Classic Nokia/S60 inspired green skin for ESP32-S3 ST7789 240x320"
    }
    studio { orientation: "portrait" targetWidth: 240 targetHeight: 320 }
    palette {
        screen: "#8CC822"
        panel: "#AFE84A"
        selected: "#DFF29B"
        titlebar: "#286C18"
        keyText: "#000000"
        chromeText: "#FFFFFF"
        accent: "#FFFF00"
        border: "#FFFFFF"
    }
    system {
        titlebarHeight: 27px
        softkeyHeight: 22px
        menuColumns: 3
        menuRows: 4
        iconSize: 36px
        statusIcons: [ "wifi", "battery" ]
        statusGap: 6px
        cellular: false
    }
</theme>
