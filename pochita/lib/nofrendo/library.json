{
  "name": "nofrendo",
  "version": "1.0.0-pochita",
  "description": "Nofrendo NES emulator portable core (Matthew Conte, GPL-2.0), vendored for PochitaOS. OSD layer is implemented in src/nes_emulator.cpp.",
  "keywords": ["nes", "emulator", "nofrendo", "esp32"],
  "license": "GPL-2.0-only",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "srcFilter": [
      "+<*.c>",
      "+<cpu/*.c>",
      "+<libsnss/*.c>",
      "+<nes/*.c>",
      "+<sndhrdw/*.c>",
      "+<mappers/*.c>"
    ],
    "flags": [
      "-w",
      "-I cpu",
      "-I nes",
      "-I sndhrdw",
      "-I libsnss",
      "-I ."
    ]
  }
}
